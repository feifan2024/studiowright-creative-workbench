diff --git a/internal/service/priority.go b/internal/service/priority.go
new file mode 100644
index 0000000..4bbe25a
--- /dev/null
+++ b/internal/service/priority.go
@@ -0,0 +1,75 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math"
+	"net/http"
+	"sort"
+	"strings"
+
+	"flowmusic2api/internal/domain"
+)
+
+type accountPriority map[string]int
+
+func (s *GenerationService) GenerateInAccountOrder(ctx context.Context, prompt, model string, emails []string) (GenerationOutput, error) {
+	priority := make(accountPriority, len(emails))
+	for _, email := range emails {
+		key := strings.ToLower(strings.TrimSpace(email))
+		if _, exists := priority[key]; key != "" && !exists {
+			priority[key] = len(priority)
+		}
+	}
+	return s.generateWithProgress(ctx, prompt, model, nil, priority)
+}
+
+func (priority accountPriority) sort(accounts []domain.Account) {
+	sort.SliceStable(accounts, func(i, j int) bool {
+		left, right := accounts[i], accounts[j]
+		a, knownA := priority[strings.ToLower(strings.TrimSpace(left.Email))]
+		b, knownB := priority[strings.ToLower(strings.TrimSpace(right.Email))]
+		if knownA != knownB {
+			return knownA
+		}
+		if knownA && a != b {
+			return a < b
+		}
+		return left.ID < right.ID
+	})
+}
+
+func (c *FlowMusicClient) availableMusicCredits(ctx context.Context, account domain.Account) (float64, error) {
+	var payload struct {
+		Data map[string]any `json:"data"`
+	}
+	if err := c.doJSON(ctx, account.ProxyURL, http.MethodGet, c.cfg.FlowMusicBaseURL+"/__api/billing/credits", &account, nil, &payload, nil); err != nil {
+		return 0, err
+	}
+	raw, _ := directValue(payload.Data, "credits_remaining")
+	remaining, ok := numericValue(raw)
+	if !ok || math.IsNaN(remaining) || math.IsInf(remaining, 0) || remaining < 0 {
+		return 0, fmt.Errorf("remaining music credits are unavailable")
+	}
+	return remaining, nil
+}
+
+// A verified rejection of the initial POST permits moving to another account.
+// A timeout or a failed stream can leave a billable job behind.
+func isPriorityAccountRejection(err error) bool {
+	var upstream *upstreamHTTPError
+	if !errors.As(err, &upstream) {
+		return false
+	}
+	switch upstream.StatusCode {
+	case http.StatusUnauthorized, http.StatusForbidden, http.StatusPaymentRequired, http.StatusTooManyRequests:
+		return true
+	case http.StatusBadRequest, http.StatusUnprocessableEntity:
+		body := strings.ToLower(upstream.Body)
+		return strings.Contains(body, "insufficient credits") || strings.Contains(body, "insufficient_credits") ||
+			strings.Contains(body, "credits_exhausted") || strings.Contains(body, "not enough credits")
+	default:
+		return false
+	}
+}
diff --git a/internal/service/priority_test.go b/internal/service/priority_test.go
new file mode 100644
index 0000000..3ddacc5
--- /dev/null
+++ b/internal/service/priority_test.go
@@ -0,0 +1,136 @@
+package service
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"reflect"
+	"sync"
+	"testing"
+	"time"
+
+	"flowmusic2api/internal/config"
+	"flowmusic2api/internal/domain"
+	"flowmusic2api/internal/storage"
+	"flowmusic2api/internal/store"
+)
+
+func TestMusicPriorityGeneration(t *testing.T) {
+	tests := []struct {
+		name         string
+		firstCredits int
+		disabled     bool
+		rejection    int
+		streamError  int
+		requests     int
+		wantAttempts []string
+		wantLogs     int
+		wantError    bool
+	}{
+		{name: "reuse the first account", firstCredits: 12, requests: 2, wantAttempts: []string{"first", "first"}, wantLogs: 2},
+		{name: "skip exhausted account", firstCredits: 0, requests: 1, wantAttempts: []string{"next"}, wantLogs: 1},
+		{name: "skip disabled account", firstCredits: 12, disabled: true, requests: 1, wantAttempts: []string{"next"}, wantLogs: 1},
+		{name: "move after explicit quota rejection", firstCredits: 12, rejection: 429, requests: 1, wantAttempts: []string{"first", "next"}, wantLogs: 1},
+		{name: "move after explicit authorization rejection", firstCredits: 12, rejection: 403, requests: 1, wantAttempts: []string{"first", "next"}, wantLogs: 1},
+		{name: "stop on ambiguous submit failure", firstCredits: 12, rejection: 503, requests: 1, wantAttempts: []string{"first"}, wantLogs: 1, wantError: true},
+		{name: "keep accepted job on its account", firstCredits: 12, streamError: 403, requests: 1, wantAttempts: []string{"first"}, wantLogs: 1, wantError: true},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			ctx := context.Background()
+			var mu sync.Mutex
+			var attempts []string
+			const clipID = "11111111-1111-1111-1111-111111111111"
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				auth := r.Header.Get("Authorization")
+				switch r.URL.Path {
+				case "/__api/billing/credits":
+					credits := 12
+					if auth == "Bearer first" {
+						credits = test.firstCredits
+					}
+					writeTestJSON(t, w, map[string]any{"data": map[string]int{"credits_remaining": credits}})
+				case "/__api/conversation":
+					account := "next"
+					if auth == "Bearer first" {
+						account = "first"
+					}
+					mu.Lock()
+					attempts = append(attempts, account)
+					mu.Unlock()
+					if account == "first" && test.rejection != 0 {
+						http.Error(w, "test rejection", test.rejection)
+						return
+					}
+					writeTestJSON(t, w, map[string]string{"job_id": "fixture"})
+				case "/__api/messages/fixture/stream":
+					if test.streamError != 0 {
+						http.Error(w, "test stream failure", test.streamError)
+						return
+					}
+					w.Header().Set("Content-Type", "text/event-stream")
+					_, _ = fmt.Fprintf(w, "data: {\"clip_id\":%q}\n\ndata: [DONE]\n\n", clipID)
+				case "/__api/clips":
+					writeTestJSON(t, w, map[string]any{"clips": map[string]any{
+						clipID: map[string]string{"id": clipID, "audio_url": "https://example.test/test.mp3"},
+					}})
+				default:
+					t.Errorf("unexpected local upstream path: %s", r.URL.Path)
+					w.WriteHeader(http.StatusNotFound)
+				}
+			}))
+			defer upstream.Close()
+			dir := t.TempDir()
+			cfg := config.Config{
+				DataDir: dir, CacheDir: dir, DatabaseDriver: "sqlite", DatabaseURL: filepath.Join(dir, "music.db"),
+				FlowMusicBaseURL: upstream.URL, UpstreamTimeout: 3 * time.Second, GenerationTimeout: 3 * time.Second,
+			}
+			db, err := store.New(ctx, cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer db.Close()
+			if err := db.Migrate(ctx); err != nil {
+				t.Fatal(err)
+			}
+			if err := db.EnsureDefaults(ctx); err != nil {
+				t.Fatal(err)
+			}
+			for _, name := range []string{"next", "first"} {
+				id, err := db.CreateAccount(ctx, domain.Account{Email: name + "@example.test", ProtocolMode: "bearer", FlowBearer: name})
+				if err != nil {
+					t.Fatal(err)
+				}
+				if test.disabled && name == "first" {
+					if err := db.SetAccountActive(ctx, id, false); err != nil {
+						t.Fatal(err)
+					}
+				}
+			}
+			client := NewFlowMusicClient(cfg)
+			cache := storage.NewCache(cfg, db, NewHTTPClient(cfg, ""))
+			generation := NewGenerationService(cfg, db, NewAccountService(cfg, db, client), client, cache)
+			for i := 0; i < test.requests; i++ {
+				out, err := generation.GenerateInAccountOrder(ctx, "fixture prompt", "flowmusic-producer-standard",
+					[]string{"FIRST@example.test", "next@example.test"})
+				if (err != nil) != test.wantError {
+					t.Fatalf("generation error = %v, wanted error: %v", err, test.wantError)
+				}
+				if err == nil && (out.JobID == "" || len(out.Clips) != 1) {
+					t.Fatalf("incomplete result: %+v", out)
+				}
+			}
+			mu.Lock()
+			if !reflect.DeepEqual(attempts, test.wantAttempts) {
+				t.Errorf("submission attempts = %v; want %v", attempts, test.wantAttempts)
+			}
+			mu.Unlock()
+			logs, err := db.GetLogs(ctx, 20)
+			if err != nil || len(logs) != test.wantLogs {
+				t.Fatalf("logs = %v; err = %v; want %d record(s)", logs, err, test.wantLogs)
+			}
+		})
+	}
+}
